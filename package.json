{
  "name": "@norehq/open-graph",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm format:check && pnpm -r --if-present typecheck && pnpm -r --if-present test",
    "release:cf": "pnpm --filter @norehq/open-graph-web run release:cf",
    "sync": "pnpm --filter @norehq/open-graph-web run sync",
    "dev": "pnpm --parallel --filter @norehq/open-graph-api --filter @norehq/open-graph-web dev",
    "dev:api": "pnpm --filter @norehq/open-graph-api dev",
    "dev:web": "pnpm --filter @norehq/open-graph-web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@norehq/prettier": "^0.1.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1"
  },
  "prettier": "@norehq/prettier"
}
