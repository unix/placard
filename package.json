{
  "name": "@unix/placard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm format:check && pnpm -r --if-present typecheck && pnpm -r --if-present test",
    "release:cf": "pnpm --filter @unix/placard-web run release:cf",
    "release:container": "bash ./scripts/release-container.sh",
    "sync": "pnpm --filter @unix/placard-web run sync",
    "dev": "pnpm --parallel --filter @unix/placard-api --filter @unix/placard-web dev",
    "dev:api": "pnpm --filter @unix/placard-api dev",
    "dev:web": "pnpm --filter @unix/placard-web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@norehq/prettier": "^0.1.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1"
  },
  "prettier": "@norehq/prettier"
}
