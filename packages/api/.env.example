# Anonymous requests are rate-limited. Requests with this Bearer token bypass the
# rate limit. Required when OG_ALLOW_ANONYMOUS=false.
OG_INTERNAL_TOKEN=

# Set false to require OG_INTERNAL_TOKEN for every API request. OG_WEB_ENABLED
# must also be false because the browser UI does not expose the internal token.
OG_ALLOW_ANONYMOUS=true

# Serve the bundled web UI from /. Set false for an API-only deployment.
OG_WEB_ENABLED=true

# Anonymous render abuse protection. Authorized requests bypass this limit.
# Invalid or empty values use this default.
OG_RATE_LIMIT_MAX=600

# Remote custom logos must use public HTTPS URLs.
OG_REMOTE_IMAGE_CACHE_MAX=50
OG_REMOTE_IMAGE_CACHE_TTL_MS=86400000
OG_REMOTE_IMAGE_MAX_BYTES=4194304
OG_REMOTE_IMAGE_TIMEOUT_MS=5000

# Optional comma-separated trusted proxy IPs, CIDRs, or proxy-addr names.
# Example for a local reverse proxy: loopback
OG_TRUST_PROXY=

HOST=0.0.0.0
PORT=3003
