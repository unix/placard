---
import { TemplateGallery } from '@/components/template-gallery'
import MainLayout from '@/layouts/main.astro'
---

<MainLayout
  description="Nore OG 是一个可自部署的 Open Graph 图片生成器，支持模板、内容预设及 SVG/PNG 下载。"
  lang="zh-CN"
  title="Nore OG">
  <main class="h-svh min-h-0 overflow-hidden">
    <TemplateGallery client:only="react" locale="zh-CN" />
  </main>
</MainLayout>

<style is:global>
  html,
  body {
    height: 100%;
    overflow: hidden;
    overscroll-behavior: none;
  }
</style>
