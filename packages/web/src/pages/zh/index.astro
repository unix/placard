---
import { TemplateGallery } from '@/components/template-gallery'
import MainLayout from '@/layouts/main.astro'
---

<MainLayout
  alternateOpenGraphLocale="en_US"
  description="面向应用的服务端卡片生成器，通过模板批量、自动化生成指定风格的 Open Graph 图片，支持自部署以及通过 Web 界面或 API 输出 SVG/PNG。"
  imageAlt="Placard 开源社交图片渲染器"
  lang="zh-CN"
  openGraphLocale="zh_CN"
  title="Placard · 开源社交图片渲染器">
  <main
    class="h-svh min-h-0 overflow-hidden max-lg:h-auto max-lg:min-h-dvh max-lg:overflow-visible">
    <TemplateGallery client:only="react" locale="zh-CN" />
  </main>
</MainLayout>

<style is:global>
  html,
  body {
    height: 100%;
    overflow: hidden;
    overscroll-behavior: none;
  }

  @media (max-width: 63.999rem) {
    html,
    body {
      height: auto;
      min-height: 100%;
      overflow: visible;
      overscroll-behavior: auto;
    }
  }
</style>
