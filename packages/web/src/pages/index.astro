---
import { TemplateGallery } from '@/components/template-gallery'
import MainLayout from '@/layouts/main.astro'
---

<MainLayout
  alternateOpenGraphLocale="zh_CN"
  description="Generate branded Open Graph cards automatically and at scale from templates. Self-host Nore OG and render SVG or PNG images through its web UI or API."
  imageAlt="Nore OG server-side Open Graph card generator"
  lang="en-US"
  openGraphLocale="en_US"
  title="Nore OG · Server-side Open Graph Card Generator">
  <main class="h-svh min-h-0 overflow-hidden">
    <TemplateGallery client:only="react" locale="en-US" />
  </main>
</MainLayout>

<style is:global>
  html,
  body {
    height: 100%;
    overflow: hidden;
    overscroll-behavior: none;
  }
</style>
