---
import { TemplateGallery } from '@/components/template-gallery'
import MainLayout from '@/layouts/main.astro'
---

<MainLayout
  alternateOpenGraphLocale="zh_CN"
  description="Generate branded social images automatically and at scale from templates. Self-host Placard and render SVG or PNG images through its web UI or API."
  imageAlt="Placard open-source social image renderer"
  lang="en-US"
  openGraphLocale="en_US"
  title="Placard · Open-source Social Image Renderer">
  <main
    class="h-svh min-h-0 overflow-hidden max-lg:h-auto max-lg:min-h-dvh max-lg:overflow-visible">
    <TemplateGallery client:only="react" locale="en-US" />
  </main>
</MainLayout>

<style is:global>
  html,
  body {
    height: 100%;
    overflow: hidden;
    overscroll-behavior: none;
  }

  @media (max-width: 63.999rem) {
    html,
    body {
      height: auto;
      min-height: 100%;
      overflow: visible;
      overscroll-behavior: auto;
    }
  }
</style>
