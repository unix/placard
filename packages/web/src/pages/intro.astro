---
import { GitHubLink } from '@/components/github-link'
import { ThemeToggle } from '@/components/theme-toggle'
import MainLayout from '@/layouts/main.astro'

const endpoints = [
  ['GET /api/health', 'Check service health'],
  ['GET /api/templates-minify', 'List template IDs and names'],
  ['GET /api/templates', 'Get templates and configuration'],
  ['GET /api/render.svg', 'Generate an SVG image'],
  ['GET /api/render.png', 'Generate a PNG image'],
  ['POST /api/render', 'Generate an SVG or PNG from JSON'],
]

const parameters = [
  [
    'template',
    'string',
    'gradient-sunset',
    'Template ID. Read the available IDs from GET /api/templates.',
  ],
  ['title', 'string', 'Untitled page', 'Main title, up to 160 length units.'],
  ['description', 'string', 'empty', 'Supporting text, up to 260 length units.'],
  [
    'author',
    'string | string[]',
    'empty',
    'Author names. Each item is limited to 30 length units and the combined label to 50. Repeat author or author[] in a query; JSON may use an array.',
  ],
  [
    'date',
    'string',
    'empty',
    'Display date or date-like label, up to 80 characters.',
  ],
  [
    'brandName',
    'string',
    'empty',
    'Brand or publication name, up to 80 characters.',
  ],
  [
    'logoId',
    'string',
    'none',
    'Built-in logo ID, none, or custom, up to 80 characters. Read the catalog from GET /api/templates.',
  ],
  [
    'logoUrl',
    'string',
    'empty',
    'Required when logoId is custom. Must be a public HTTPS URL of up to 500 characters.',
  ],
  [
    'maxTitleLength',
    'integer',
    '160',
    'Truncates the title to a value from 4 through 160 length units.',
  ],
  [
    'maxDescriptionLength',
    'integer',
    '260',
    'Truncates the description to a value from 4 through 260 length units.',
  ],
  [
    'canvasColor',
    'string',
    'transparent',
    'Outer canvas color: transparent or a 3, 4, 6, or 8-digit hex color.',
  ],
  [
    'canvasPadding',
    'integer',
    '0',
    'Padding around the image content, from 0 through 337.',
  ],
  [
    'canvasRadius',
    'integer',
    '0',
    'Outer canvas corner radius, from 0 through 337.',
  ],
  [
    'contentRadius',
    'integer | auto',
    'auto',
    'Content corner radius from 0 through 337. auto uses max(canvasRadius - canvasPadding, 0).',
  ],
  [
    'seed',
    'string',
    'auto',
    'Seed for deterministic template variation, from 1 through 64 characters.',
  ],
  [
    'lang',
    'string',
    'en-US',
    'Text language: en-US, zh-CN, zh-TW, ja-JP, or ko-KR.',
  ],
  [
    'format',
    'png | svg',
    'png',
    'POST /api/render only. GET requests select the format through the endpoint path.',
  ],
]

const environmentVariables = [
  [
    'OG_WEB_ENABLED',
    'true',
    'Serve the bundled web UI. Set false for an API-only container.',
  ],
  [
    'OG_ALLOW_ANONYMOUS',
    'true',
    'Accept requests without a token. Setting false also requires OG_WEB_ENABLED=false and OG_INTERNAL_TOKEN.',
  ],
  [
    'OG_INTERNAL_TOKEN',
    'unset',
    'Bearer token. Valid token requests bypass rate limiting; required when anonymous traffic is disabled.',
  ],
  [
    'OG_RATE_LIMIT_MAX',
    '600',
    'Maximum anonymous render requests per IP per minute.',
  ],
  [
    'OG_REMOTE_IMAGE_CACHE_MAX',
    '50',
    'Maximum number of remote custom logos kept in the per-process LRU cache.',
  ],
  [
    'OG_REMOTE_IMAGE_CACHE_TTL_MS',
    '86400000',
    'Remote custom logo cache lifetime in milliseconds. The default is 24 hours.',
  ],
  [
    'OG_REMOTE_IMAGE_MAX_BYTES',
    '4194304',
    'Maximum downloaded size in bytes for a custom remote logo.',
  ],
  [
    'OG_REMOTE_IMAGE_TIMEOUT_MS',
    '5000',
    'Timeout in milliseconds when downloading a custom remote logo.',
  ],
  [
    'OG_TRUST_PROXY',
    'unset',
    'Comma-separated trusted proxy IPs, CIDRs, or proxy-addr names such as loopback.',
  ],
  ['HOST', '0.0.0.0', 'Address on which the API listens.'],
  ['PORT', '3003', 'Port on which the API listens inside the container.'],
  ['LOG_LEVEL', 'info', 'API log level, such as debug, info, warn, or error.'],
]

const performanceResults = [
  ['1', '465.04 req/s', '2.15 ms', '2 ms', '3 ms', '7 ms'],
  ['4', '543.81 req/s', '7.36 ms', '7 ms', '12 ms', '21 ms'],
  ['8', '599.27 req/s', '13.35 ms', '13 ms', '19 ms', '24 ms'],
]

const tableContainerClassName = 'mt-5 overflow-x-auto lg:overflow-visible'
const tableClassName =
  'w-full max-w-full table-fixed text-left text-sm lg:relative lg:left-1/2 lg:w-[130%] lg:max-w-none lg:-translate-x-1/2 lg:table-auto'
const tableCodeClassName =
  'font-mono text-xs break-all lg:break-normal lg:whitespace-nowrap'
---

<MainLayout
  alternateOpenGraphLocale="zh_CN"
  description="Learn how Nore OG helps applications generate branded cards automatically and at scale, explore its rendering APIs, and deploy the service yourself."
  imageAlt="Nore OG server-side Open Graph card generator"
  lang="en-US"
  openGraphLocale="en_US"
  title="About Nore OG · Server-side Open Graph Card Generator">
  <header class="border-b">
    <nav
      aria-label="Main navigation"
      class="mx-auto flex h-14 w-full max-w-4xl items-center justify-between px-4">
      <a class="flex items-center gap-2.5" href="/">
        <img
          alt="Nore OG"
          class="size-7 rounded-md"
          height="28"
          src="/logo/logo.svg"
          width="28"
        />
        <span class="hidden text-sm font-medium sm:inline">Nore OG</span>
      </a>
      <div class="flex items-center gap-1 text-xs">
        <a
          class="rounded-md px-2.5 py-1.5 text-muted-foreground hover:bg-muted hover:text-foreground"
          href="/">
          App
        </a>
        <a
          aria-current="page"
          class="rounded-md px-2.5 py-1.5 font-medium"
          href="/intro">
          Introduction
        </a>
        <GitHubLink locale="en-US" />
        <a
          class="rounded-md px-2.5 py-1.5 text-muted-foreground hover:bg-muted hover:text-foreground"
          href="/zh/intro">
          中文
        </a>
        <ThemeToggle locale="en-US" />
      </div>
    </nav>
  </header>

  <main class="mx-auto w-full max-w-2xl px-4 py-16 sm:py-24">
    <section>
      <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">
        Open Graph image generator
      </h1>
      <p class="mt-5 text-sm leading-7 text-muted-foreground">
        Nore OG is a server-side card generator for applications that need to create
        cards in a specific visual style automatically and at scale. It creates the
        preview images people see when a link is shared: pick a template, add a title
        and description, then preview and download an SVG or PNG image.
      </p>
    </section>

    <section class="mt-12">
      <h2 class="text-lg font-medium">What it is for</h2>
      <p class="mt-3 text-sm leading-7 text-muted-foreground">
        Create images for blog posts, product pages, and release notes. Make a single
        image by hand, or generate images automatically through the API to keep your
        pages visually consistent.
      </p>
    </section>

    <section class="mt-12 scroll-mt-8" id="api">
      <h2 class="text-lg font-medium">APIs</h2>
      <p class="mt-3 text-sm leading-7 text-muted-foreground">
        This site is a demo, with no guarantee of API availability. Please <a
          class="text-foreground underline underline-offset-4"
          href="#self-host">self-host Nore OG</a
        > and use your own API address.
      </p>
      <div class={tableContainerClassName}>
        <table class={tableClassName}>
          <thead>
            <tr class="border-b">
              <th class="py-3 pr-6 font-medium" scope="col">Endpoint</th>
              <th class="py-3 font-medium" scope="col">Purpose</th>
            </tr>
          </thead>
          <tbody>
            {
              endpoints.map(([endpoint, description]) => (
                <tr class="border-b">
                  <td class="py-3 pr-6">
                    <code class={tableCodeClassName}>{endpoint}</code>
                  </td>
                  <td class="py-3 text-muted-foreground">{description}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-sm leading-7 text-muted-foreground">
        Render endpoints accept a template, title, and other content. GET requests
        use URL parameters; POST requests use JSON, with format set to svg or png.
      </p>
    </section>

    <section class="mt-12 scroll-mt-8" id="parameters">
      <h2 class="text-lg font-medium">Parameters</h2>
      <p class="mt-3 text-sm leading-7 text-muted-foreground">
        The GET render endpoints accept these values as URL query parameters. POST
        /api/render accepts the same values in a JSON object. Current defaults,
        limits, templates, and logo IDs are also available from GET /api/templates.
      </p>
      <div class={tableContainerClassName}>
        <table class={tableClassName}>
          <thead>
            <tr class="border-b">
              <th class="py-3 pr-5 font-medium" scope="col">Parameter</th>
              <th class="py-3 pr-5 font-medium" scope="col">Type</th>
              <th class="py-3 pr-5 font-medium" scope="col">Default</th>
              <th class="py-3 font-medium" scope="col">Purpose</th>
            </tr>
          </thead>
          <tbody>
            {
              parameters.map(([name, type, defaultValue, description]) => (
                <tr class="border-b align-top">
                  <td class="py-3 pr-5">
                    <code class={tableCodeClassName}>{name}</code>
                  </td>
                  <td class="py-3 pr-5">
                    <code class={tableCodeClassName}>{type}</code>
                  </td>
                  <td class="py-3 pr-5">
                    <code class={tableCodeClassName}>{defaultValue}</code>
                  </td>
                  <td class="py-3 text-muted-foreground">{description}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-sm leading-7 text-muted-foreground">
        A length unit counts Han and full-width characters as two and other
        characters as one. Invalid render behavior values fall back to their
        defaults. Successful responses list those fields in the
        X-Render-Fallback-Fields header. Invalid content fields return a 400
        response.
      </p>
    </section>

    <section class="mt-12 scroll-mt-8" id="self-host">
      <h2 class="text-lg font-medium">Self-hosting</h2>
      <p class="mt-3 text-sm leading-7 text-muted-foreground">
        Get the <a
          class="text-foreground underline underline-offset-4"
          href="https://github.com/norehq/og">source code</a
        >, then build and run the Docker image from the repository root. The image
        includes both the Web UI and rendering API:
      </p>
      <pre
        class="mt-4 overflow-x-auto rounded-lg border bg-muted/30 p-4 font-mono text-xs leading-6"><code>docker build --tag nore-og .
docker run --detach \
  --name nore-og \
  --restart unless-stopped \
  --publish 3003:3003 \
  nore-og</code></pre>
      <p class="mt-4 text-sm leading-7 text-muted-foreground">
        Open http://localhost:3003 for the UI. The browser calls the API under /api
        on the same origin, so a Docker deployment does not need an API address.
      </p>

      <h3 class="mt-10 scroll-mt-8 text-base font-medium" id="environment">
        Environment variables
      </h3>
      <p class="mt-3 text-sm leading-7 text-muted-foreground">
        Pass runtime settings with Docker --env or --env-file. Empty or invalid
        positive-integer values use the documented defaults.
      </p>
      <div class={tableContainerClassName}>
        <table class={tableClassName}>
          <thead>
            <tr class="border-b">
              <th class="py-3 pr-5 font-medium" scope="col">Variable</th>
              <th class="py-3 pr-5 font-medium" scope="col">Default</th>
              <th class="py-3 font-medium" scope="col">Purpose</th>
            </tr>
          </thead>
          <tbody>
            {
              environmentVariables.map(([name, defaultValue, description]) => (
                <tr class="border-b align-top">
                  <td class="py-3 pr-5">
                    <code class={tableCodeClassName}>{name}</code>
                  </td>
                  <td class="py-3 pr-5">
                    <code class={tableCodeClassName}>{defaultValue}</code>
                  </td>
                  <td class="py-3 text-muted-foreground">{description}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h3 class="mt-10 text-base font-medium">Configuration examples</h3>
      <p class="mt-3 text-sm leading-7 text-muted-foreground">
        To run an API-only container that rejects anonymous requests, disable both
        the Web UI and anonymous traffic, then configure a token:
      </p>
      <pre
        class="mt-4 overflow-x-auto rounded-lg border bg-muted/30 p-4 font-mono text-xs leading-6"><code>docker run --detach \
  --name nore-og-api \
  --restart unless-stopped \
  --publish 3003:3003 \
  --env OG_WEB_ENABLED=false \
  --env OG_ALLOW_ANONYMOUS=false \
  --env OG_INTERNAL_TOKEN=replace-with-a-secret \
  nore-og</code></pre>
      <p class="mt-4 text-sm leading-7 text-muted-foreground">
        For several settings, place them in an environment file and pass it to
        Docker:
      </p>
      <pre
        class="mt-4 overflow-x-auto rounded-lg border bg-muted/30 p-4 font-mono text-xs leading-6"><code># nore-og.env
OG_WEB_ENABLED=false
OG_ALLOW_ANONYMOUS=true
OG_INTERNAL_TOKEN=replace-with-a-secret
OG_RATE_LIMIT_MAX=1200
LOG_LEVEL=info</code></pre>
      <pre
        class="mt-4 overflow-x-auto rounded-lg border bg-muted/30 p-4 font-mono text-xs leading-6"><code>docker run --detach \
  --name nore-og-api \
  --restart unless-stopped \
  --publish 3003:3003 \
  --env-file ./nore-og.env \
  nore-og</code></pre>
    </section>

    <section class="mt-12 scroll-mt-8" id="performance">
      <h2 class="text-lg font-medium">Performance estimate</h2>
      <p class="mt-3 text-sm leading-7 text-muted-foreground">
        A local reference test of <code>GET /api/render.svg</code> used the
        <code>gradient-sunset</code> template with a title, description, author, brand
        name, and fixed seed. The first cold render took 101.2 ms and returned a 22,512-byte
        SVG. After fonts and the runtime were warm, 500 keep-alive requests at each concurrency
        level produced the following results with no failures:
      </p>
      <div class={tableContainerClassName}>
        <table class={tableClassName}>
          <thead>
            <tr class="border-b">
              <th class="py-3 pr-5 font-medium" scope="col">Concurrency</th>
              <th class="py-3 pr-5 font-medium" scope="col">Throughput</th>
              <th class="py-3 pr-5 font-medium" scope="col">Mean</th>
              <th class="py-3 pr-5 font-medium" scope="col">P50</th>
              <th class="py-3 pr-5 font-medium" scope="col">P95</th>
              <th class="py-3 font-medium" scope="col">P99</th>
            </tr>
          </thead>
          <tbody>
            {
              performanceResults.map(
                ([concurrency, throughput, mean, p50, p95, p99]) => (
                  <tr class="border-b align-top">
                    <td class="py-3 pr-5">
                      <code class={tableCodeClassName}>{concurrency}</code>
                    </td>
                    <td class="py-3 pr-5">
                      <code class={tableCodeClassName}>{throughput}</code>
                    </td>
                    <td class="py-3 pr-5">
                      <code class={tableCodeClassName}>{mean}</code>
                    </td>
                    <td class="py-3 pr-5">
                      <code class={tableCodeClassName}>{p50}</code>
                    </td>
                    <td class="py-3 pr-5">
                      <code class={tableCodeClassName}>{p95}</code>
                    </td>
                    <td class="py-3">
                      <code class={tableCodeClassName}>{p99}</code>
                    </td>
                  </tr>
                ),
              )
            }
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-sm leading-7 text-muted-foreground">
        Test environment: the Docker image in API-only mode on an Apple Silicon
        machine (10 CPU cores, 64 GiB memory), with no container CPU or memory limit,
        Node.js 24.22.1, loopback networking, logging disabled, and a valid Bearer
        token to bypass anonymous rate limiting. ApacheBench generated the load.
        Treat these figures as an estimate rather than a service-level guarantee: CPU
        allocation, templates, input length, concurrent workload, and remote logo
        downloads can all change latency. PNG rendering and remote logo download time
        were not included.
      </p>

      <h3 class="mt-10 text-base font-medium">Performance recommendations</h3>
      <p class="mt-3 text-sm leading-7 text-muted-foreground">
        The API renders each SVG or PNG dynamically and is sufficient for most
        workloads. Its remote Logo cache only avoids downloading the same source
        image repeatedly; it does not cache the final render. The GET render
        endpoints return
        <code>Cache-Control: public, max-age=300</code>, allowing an upstream cache
        to reuse a result for five minutes with the complete request URL, including
        its query string, as the cache key.
      </p>
      <p class="mt-3 text-sm leading-7 text-muted-foreground">
        For latency-sensitive applications, frequently requested images, or multiple
        API instances, place a shared response cache in front of the API. Suitable
        options include Nginx or another caching reverse proxy, Caddy with a caching
        plugin, and a CDN such as Cloudflare configured to cache these GET responses.
        Cache hits are then served without reaching the Node.js process, avoiding
        repeated rendering of identical content. Choose a freshness period that
        matches how often the content changes, and use a versioned URL or purge the
        upstream cache when an image must update immediately. If anonymous access is
        disabled, make sure authentication happens before cache lookup, or isolate
        protected responses so a shared cache cannot bypass the Token requirement.
      </p>
    </section>
  </main>
</MainLayout>
